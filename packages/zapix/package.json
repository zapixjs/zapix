{
  "name": "zapix",
  "version": "0.1.9",
  "description": "Zapix: Lightweight, Express-style router for AWS Lambda and API Gateway v2. Build serverless APIs with middleware, type safety, and minimal setup.",
  "main": "dist/public/index.js",
  "types": "dist/public/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "prepublishOnly": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./aws": {
      "types": "./dist/aws/index.d.ts",
      "default": "./dist/aws/index.js"
    }
  },
  "keywords": [
    "lambda",
    "router",
    "serverless",
    "api-gateway",
    "zapix"
  ],
  "author": "Raihan Sharif <raihansharif.dev@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@aws-sdk/client-lambda": "^3.972.0",
    "@repo/biome-config": "workspace:^",
    "@repo/typescript-config": "workspace:*",
    "@types/aws-lambda": "^8.10.160",
    "@types/node": "^24.10.9",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "unbuild": "^3.6.1",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/raihansharifrimon/zapix.git"
  },
  "bugs": {
    "url": "https://github.com/raihansharifrimon/zapix/issues"
  },
  "homepage": "https://github.com/raihansharifrimon/zapix#readme"
}
