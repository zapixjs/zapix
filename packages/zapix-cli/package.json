{
	"name": "zapix-cli",
	"version": "1.0.0-beta.1",
	"type": "module",
	"description": "Zapix CLI for project scaffolding and module generation",
	"bin": {
		"zpx": "./dist/index.js",
		"zapix": "./dist/index.js"
	},
	"main": "dist/index.js",
	"files": [
		"dist",
		"templates"
	],
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"lint": "biome check src",
		"format": "biome format src"
	},
	"keywords": [
		"zapix",
		"cli",
		"scaffold",
		"serverless",
		"node"
	],
	"author": "Raihan Sharif",
	"license": "MIT",
	"dependencies": {
		"async-retry": "^1.3.3",
		"async-sema": "^3.1.1",
		"commander": "^14.0.3",
		"cross-spawn": "^7.0.6",
		"fast-glob": "^3.3.3",
		"fs-extra": "^11.3.3",
		"kleur": "^4.1.5",
		"picocolors": "^1.1.1",
		"prompts": "^2.4.2",
		"tar": "^7.5.7",
		"validate-npm-package-name": "^7.0.2"
	},
	"devDependencies": {
		"@repo/biome-config": "workspace:^",
		"@repo/typescript-config": "workspace:^",
		"@types/async-retry": "^1.4.9",
		"@types/cross-spawn": "^6.0.6",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^24.10.9",
		"@types/prompts": "^2.4.9",
		"@types/validate-npm-package-name": "^4.0.2",
		"typescript": "^5.9.3"
	}
}
