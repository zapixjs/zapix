{
	"compilerOptions": {
		"lib": ["ES2024", "DOM"],
		"target": "ES2024",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"outDir": "dist",
		"rootDir": "src",
		"declarationDir": "./dist/types",
		"strict": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"checkJs": true,
		"allowJs": true,
		"declaration": true,
		"declarationMap": true,
		"allowSyntheticDefaultImports": true
	},
	"files": ["./src/index.ts"],
	"include": ["src/**/*.ts"],
	"exclude": [
		"dist",
		"node_modules",
		"**/*.spec.ts",
		"**/*.test.ts",
		"templates"
	]
}
