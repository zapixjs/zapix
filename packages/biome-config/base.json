{
	"$schema": "https://biomejs.dev/schemas/2.4.11/schema.json",
	"root": false,
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": {
		"ignoreUnknown": false,
		"experimentalScannerIgnores": ["node_modules"],
		"includes": [
			"src/**/*.{js,ts,json,md,mdx,yml,yaml,html,css,scss,sass}",
			"__tests__/**/*.ts",
			"!**/node_modules/**/*",
			"!**/.next/**",
			"!**/dist/**",
			"!**/out/**",
			"!**/.vercel/**",
			"!src/components/ui/**",
			"!tracing.json",
			"package.json",
			"tsconfig.json",
			"vitest.config.ts",
			"biome.json"
		]
	},
	"formatter": {
		"lineWidth": 120,
		"indentStyle": "tab",
		"indentWidth": 2
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error",
				"noUnusedPrivateClassMembers": "error"
			},
			"style": {
				"noCommonJs": "error",
				"noNamespace": "error",
				"useImportType": "off",
				"useConst": "error",
				"useTemplate": "error",
				"useNodejsImportProtocol": "warn",
				"useBlockStatements": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noConsole": "off",
				"noDoubleEquals": "error"
			},
			"security": {
				"noGlobalEval": "error"
			},
			"performance": {
				"noAccumulatingSpread": "warn"
			}
		}
	},
	"javascript": { "formatter": { "quoteStyle": "double" }, "globals": [] },
	"overrides": [
		{
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off",
						"noExplicitAny": "off"
					}
				}
			}
		}
	],
	"assist": {
		"enabled": true,
		"actions": { "source": { "organizeImports": "off" } }
	}
}
